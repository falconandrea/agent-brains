{
  "name": "pi-brain",
  "version": "0.0.0",
  "private": true,
  "description": "Local multi-agent workflow harness for Pi, built on the agent-brains canonical skill store",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./.agents/skills"
    ]
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "smoke:pi": "node spike/compatibility-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
